{
  "name": "crawlingo",
  "version": "1.0.0-alpha.2",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Vamshavardhan50"
  },
  "description": "Validated datasets from web pages, powered by Rust",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": { "node": ">=22" },
  "homepage": "https://crawlingo-docs.vercel.app/sdk/nodejs",
  "bugs": { "url": "https://github.com/Vamshavardhan50/crawlingo/issues" },
  "files": [
    "dist",
    "LICENSE"
  ],
  "napi": {
    "name": "crawlingo-native",
    "triples": {
      "defaults": true,
      "additional": []
    }
  },
  "scripts": {
    "build": "npm run build:native && npm run build:ts && node scripts/copy-native-assets.cjs",
    "build:native": "napi build --platform --release --js src/native.js --dts src/native.d.ts --cargo-cwd native --cargo-flags=\"--locked\" .",
    "build:debug": "napi build --platform --js src/native.js --dts src/native.d.ts --cargo-cwd native --cargo-flags=\"--locked\" .",
    "prepack": "npm run build:ts && node scripts/copy-native-assets.cjs",
    "build:ts": "tsc",
    "lint": "tsc --noEmit",
    "test": "node tests/smoke.cjs",
    "test:amazon": "node tests/amazon-scrape.cjs",
    "test:all": "node tests/test_all.cjs",
    "test:legacy": "node tests/legacy/test_all_apis.cjs",
    "check:package": "node scripts/check-package.cjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@types/node": "^25.9.3",
    "typescript": "^5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vamshavardhan50/crawlingo.git",
    "directory": "sdk/nodejs"
  }
}
