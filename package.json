{
  "name": "crawlingo-workspace",
  "private": true,
  "description": "Development commands for the Crawlingo engine, SDKs and documentation.",
  "license": "MIT",
  "scripts": {
    "build": "npm run docs:build",
    "docs:dev": "npm run dev --prefix crawlingo-docs",
    "docs:check": "npm run lint --prefix crawlingo-docs",
    "docs:build": "npm run build --prefix crawlingo-docs",
    "sdk:node": "npm run build --prefix sdk/nodejs",
    "release:check": "node scripts/check-release.cjs"
  }
}
